---
// Guia de Ilha Grande - Versão 3.7: LOGO MAXIMIZADA (190px PC / 160px Mobile)
---
<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Guia de Ilha Grande | Especialistas no Paraíso</title>
		
		<style>
			:root { --primary: #10b981; --dark: #000; --gray: #475569; --light-bg: #f8fafc; }
			body { font-family: 'Inter', sans-serif; margin: 0; padding: 0; background: #fff; overflow-x: hidden; }
			
			/* NAVBAR BASE SLIM */
			header { 
				background: white; 
				border-bottom: 1px solid #e2e8f0; 
				position: sticky; 
				top: 0; 
				z-index: 100; 
				width: 100%;
                height: 90px; /* BARRA MANTIDA FINA NO PC */
                display: flex;
                align-items: center;
			}

			.header-container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 20px;
                width: 100%;
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: relative;
			}

			/* --- CONFIGURAÇÃO DESKTOP (PC) --- */
			@media (min-width: 1024px) {
				.logo-link { 
                    position: relative; 
                    z-index: 110; 
                    height: 90px; 
                    display: flex; 
                    align-items: center; 
                }
				.logo-img { 
					height: 190px; /* LOGO NO PC: 190PX */
					width: auto; 
					position: absolute;
					top: 50%;
					transform: translateY(-50%);
					filter: drop-shadow(0 10px 15px rgba(0,0,0,0.1));
				}
				
				nav { display: flex; gap: 25px; margin-left: auto; }
				nav a { text-decoration: none; color: var(--gray); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
				nav a:hover { color: var(--primary); }
			}

			/* --- CONFIGURAÇÃO MOBILE (CELULAR) --- */
			@media (max-width: 1023px) {
				header { height: auto; padding: 10px 0; }
				.header-container { flex-direction: column; align-items: center; }
				
				.logo-link { 
                    margin-bottom: 10px; 
                    display: flex; 
                    justify-content: center;
                }
				.logo-img { 
					height: 160px; /* LOGO NO CELULAR: 160PX */
					width: auto; 
                    filter: drop-shadow(0 5px 10px rgba(0,0,0,0.1));
				}
				
				nav { 
					display: grid; 
					grid-template-columns: repeat(3, 1fr); /* 3 colunas para links diretos */
					gap: 8px; 
					width: 100%;
					padding: 10px 5%;
					border-top: 1px solid #f1f5f9;
				}
				nav a { 
					text-decoration: none; 
					color: var(--dark); 
					font-size: 9px; 
					font-weight: 800; 
					text-transform: uppercase; 
					text-align: center;
				}
			}

			/* HERO SECTION */
			.hero { 
				height: 60vh; 
				display: flex; 
				align-items: center; 
				justify-content: center; 
				text-align: center; 
				color: white; 
				background: #000;
				padding: 0 20px;
			}
			.hero h1 { font-size: clamp(2rem, 8vw, 4.5rem); margin: 0; font-weight: 900; text-transform: uppercase; line-height: 1; }
			.hero p { font-size: 1.1rem; margin: 20px 0 30px; opacity: 0.8; }
			.btn { background: var(--primary); color: white; padding: 16px 40px; border-radius: 50px; font-weight: 800; text-transform: uppercase; text-decoration: none; display: inline-block; }

			/* CARDS */
			.grid-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; padding: 50px 20px; max-width: 1200px; margin: 0 auto; }
			.card { background: white; border-radius: 15px; overflow: hidden; border: 1px solid #f1f5f9; text-align: center; box-shadow: 0 4px 6px rgba(0,0,0,0.05); }
			.card img { width: 100%; height: 200px; object-fit: cover; }
			.card h3 { margin: 15px 0 5px; text-transform: uppercase; font-size: 1.1rem; font-weight: 900; }
			.card p { color: #64748b; font-size: 0.9rem; margin-bottom: 20px; padding: 0 10px; }

            footer { background: #0f172a; color: #94a3b8; padding: 40px 20px; text-align: center; font-size: 0.8rem; }
		</style>
	</head>
	<body>

		<header>
			<div class="header-container">
				<a href="/" class="logo-link">
					<img src="/logo.webp" alt="Logo Guia de Ilha Grande" class="logo-img" />
				</a>
				
				<nav>
					<a href="#">Onde Comer</a>
					<a href="#">Onde Ficar</a>
					<a href="#">Guia Prático</a>
					<a href="#">O Que Fazer</a>
					<a href="#">Sobre Nós</a>
					<a href="#">Contato</a>
				</nav>
			</div>
		</header>

		<section class="hero">
			<div class="hero-content">
				<h1>DESCUBRA ILHA GRANDE<br/>COM ESPECIALISTAS</h1>
				<p>Roteiros reais para sua viagem perfeita.</p>
				<a href="#" class="btn">Ver Roteiros</a>
			</div>
		</section>

		<div class="grid-cards">
			<div class="card">
				<img src="https://images.unsplash.com/photo-1544551763-46a013bb70d5?w=600" alt="O que fazer" />
				<h3>O Que Fazer</h3>
				<p>Trilhas e praias desertas.</p>
			</div>
			<div class="card">
				<img src="https://images.unsplash.com/photo-1566073771259-6a8506099945?w=600" alt="Onde ficar" />
				<h3>Onde Ficar</h3>
				<p>Pousadas selecionadas.</p>
			</div>
			<div class="card">
				<img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600" alt="Onde comer" />
				<h3>Onde Comer</h3>
				<p>Gastronomia caiçara.</p>
			</div>
			<div class="card">
				<img src="https://images.unsplash.com/photo-1527489377706-5bf97e608852?w=600" alt="Guia Prático" />
				<h3>Guia Prático</h3>
				<p>Como chegar e dicas.</p>
			</div>
		</div>

		<footer>
			<p>© 2026 GUIA DE ILHA GRANDE. ESPECIALISTAS EM TURISMO.</p>
		</footer>

	</body>
</html>